# ---- Database ----
# Local development uses SQLite. For production, switch the provider in
# prisma/schema.prisma to "postgresql" and point this at your Postgres URL.
DATABASE_URL="file:./dev.db"

# ---- App ----
# Public URL of this app (used for Shopify return links and webhooks)
APP_URL="http://localhost:3000"

# ---- Shopify (leave blank to run in TEST CHECKOUT mode) ----
# Create a custom app in Shopify Admin > Settings > Apps and sales channels >
# Develop apps. Grant scopes: write_draft_orders, read_orders, write_orders,
# read_fulfillments, read_payment_terms.
SHOPIFY_STORE_DOMAIN=""          # e.g. club-custom.myshopify.com
SHOPIFY_ADMIN_ACCESS_TOKEN=""    # starts with shpat_
SHOPIFY_WEBHOOK_SECRET=""        # from Settings > Notifications > Webhooks
SHOPIFY_API_VERSION="2025-07"
