# ---- Database (Postgres) ----
# DATABASE_URL: pooled connection used by the app (on Supabase, the transaction
# pooler on port 6543 with ?pgbouncer=true&connection_limit=1 for serverless).
# DIRECT_URL: direct/session connection used by `prisma db push` and the seed.
# For local development, a local Postgres works for both, e.g.
# postgresql://postgres:postgres@localhost:5432/clubcustom
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/clubcustom"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/clubcustom"

# ---- App ----
# Public URL of this app (used for Shopify return links and webhooks)
APP_URL="http://localhost:3000"

# ---- Shopify (leave blank to run in TEST CHECKOUT mode) ----
# Create a custom app in Shopify Admin > Settings > Apps and sales channels >
# Develop apps. Grant scopes: write_draft_orders, read_orders, write_orders,
# read_fulfillments, read_payment_terms.
SHOPIFY_STORE_DOMAIN=""          # e.g. club-custom.myshopify.com
SHOPIFY_ADMIN_ACCESS_TOKEN=""    # starts with shpat_
SHOPIFY_WEBHOOK_SECRET=""        # from Settings > Notifications > Webhooks
SHOPIFY_API_VERSION="2025-07"
