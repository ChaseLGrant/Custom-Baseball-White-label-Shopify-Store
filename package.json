{
  "name": "club-custom",
  "version": "0.1.0",
  "private": true,
  "description": "Club Custom: self-service custom team uniform ordering on Shopify",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
